{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pay and Pray",
  "version": "1.6.0",
  "identifier": "app.payandpray",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Pay and Pray",
        "width": 360,
        "height": 420,
        "minWidth": 300,
        "minHeight": 180,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Pay and Pray — Set up",
        "width": 480,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Pay and Pray — Settings",
        "width": 480,
        "height": 600,
        "minWidth": 420,
        "minHeight": 460,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://claude.ai https://api.github.com https://github.com ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vishal-1908/pay-and-pray/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCQjM3NzQ0RUM0OTg1QzMKUldURGhVbnNSSGV6UzlqaHR3YkVmdlZacVJ2SE9jLzlaWkdMdUh1cEZlbjYwYmFZVlpzZFZGaXAK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Allan De Castro",
    "shortDescription": "Quota meter for Claude Code and GitHub Copilot",
    "longDescription": "Pay and Pray sits in your menu bar and tracks Claude Code and GitHub Copilot quotas across rolling windows, weekly caps, and monthly allowances — so you know when to switch models before hitting the wall."
  }
}
